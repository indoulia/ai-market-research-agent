# Copy this file to deploy/k8s/market-agent.env and fill in real values.
# deploy/k8s/market-agent.env is gitignored and is the SINGLE source of
# truth for the market-agent-secrets Kubernetes Secret -- never commit it,
# never paste real values into manifests, scripts, or docs.
#
#   kubectl create secret generic market-agent-secrets \
#     -n market-agent --from-env-file=deploy/k8s/market-agent.env

# ---- In-cluster PostgreSQL bootstrap ----
# These three configure the postgres container on first boot (deploy/k8s/base/postgres.yaml).
POSTGRES_DB=market_agent
POSTGRES_USER=market_agent
POSTGRES_PASSWORD=change-me

# Must stay in sync with the three POSTGRES_* values above. "postgres" is the
# in-cluster Service DNS name -- this is NOT the same DATABASE_URL you use
# for native local runs against an external Postgres (see root .env.example).
DATABASE_URL=postgresql+psycopg://market_agent:change-me@postgres:5432/market_agent

# ---- Optional providers ----
# app/settings.py treats these as optional. Leave a value blank to disable
# that provider/feature -- the app runs without it, just without whatever
# functionality depends on that key.
OPENAI_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz

# ---- App config ----
APP_ENV=production
LOG_LEVEL=INFO
# Same-origin ingress routing (market-agent.test) means CORS mostly doesn't
# matter in practice, but keep this scoped rather than "*" once a real host
# is chosen. Deliberately NOT a *.localhost host: Chromium-based browsers
# hardcode the whole .localhost TLD to 127.0.0.1 and ignore the hosts file,
# which breaks routing through Traefik's real (non-127.0.0.1) address.
CORS_ALLOWED_ORIGINS=http://market-agent.test
