# Copy this file to .env and fill in real values. .env is gitignored.
#
# `docker compose up` reads this file automatically (same directory as
# docker-compose.yml) -- one file controls Postgres bootstrap, provider
# tokens, and which market-data provider is active.

# ---- Native run only (python -m uvicorn ...) ----
# Ignored by docker-compose services, which build their own DATABASE_URL
# from the POSTGRES_* values below so it always points at the in-network
# `postgres` service rather than localhost.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/market_agent

# ---- docker-compose Postgres bootstrap ----
POSTGRES_DB=market_agent
POSTGRES_USER=market_agent
POSTGRES_PASSWORD=change-me

# ---- Providers ----
# Leave a value blank to disable that provider/feature -- the app runs
# without it, just without whatever functionality depends on that key.
OPENAI_API_KEY=

# scripts/ingest_market_history.py (and the `docker compose run --rm ingest`
# service) reads MARKET_DATA_PROVIDER to pick which client to use, so
# switching providers is an env change only, no script/code change:
#   upstox -> full NSE instrument-master + candles, needs UPSTOX_ACCESS_TOKEN
#   yahoo  -> stopgap while an Upstox account is pending; no instrument
#             master, so the universe is exactly YAHOO_SYMBOLS
MARKET_DATA_PROVIDER=yahoo

UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz

# Comma-separated bare NSE symbols, e.g. RELIANCE,TCS,INFY (not RELIANCE.NS).
YAHOO_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# ---- App config ----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*

# Baked into the Flutter web build at `docker compose build` time (build arg,
# not a runtime env var) -- must be a URL the browser can reach, so the
# compose default is the host-mapped API port, not the in-network service name.
API_BASE_URL=http://localhost:8000
